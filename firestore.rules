// Firestore security rules for GoodFinances.
// Single source of truth — paste into the Firestore "Rules" tab and publish.
// See docs/firebase-setup.md and docs/sync.md.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Invite: resolves a code -> household. Direct GET only (whoever holds the
    // code); nobody can LIST the existing codes. Creating an invite requires
    // already being a member of the household it points at — otherwise any
    // authenticated user could register codes aimed at someone else's
    // household (squatting/phishing).
    match /convites/{codigo} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/casas/$(request.resource.data.casaId))
        && request.auth.uid in
           get(/databases/$(database)/documents/casas/$(request.resource.data.casaId)).data.membros;
      allow update, delete: if false;
    }

    match /casas/{casaId} {
      // On create, the owner must include themselves in membros and be criadoPor.
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.membros
        && request.resource.data.criadoPor == request.auth.uid;
      // Members only may read the household; no listing (blocks enumerating codes)
      allow get: if request.auth != null
        && request.auth.uid in resource.data.membros;
      allow list: if false;
      allow update: if request.auth != null
        && (
          // An existing member edits (leaving, self-repairing the invite).
          request.auth.uid in resource.data.membros
          // Or joining via invite: was NOT a member, the new state only ADDS
          // their own uid (keeping every current one) and touches neither the
          // invite code nor the creator. Without this, any authenticated user
          // who learned the casaId could replace the whole member list.
          || (
            !(request.auth.uid in resource.data.membros)
            && request.auth.uid in request.resource.data.membros
            && request.resource.data.membros.hasAll(resource.data.membros)
            && request.resource.data.membros.size() == resource.data.membros.size() + 1
            && request.resource.data.codigoConvite == resource.data.codigoConvite
            && request.resource.data.criadoPor == resource.data.criadoPor
          )
        );

      function ehMembro() {
        return request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/casas/$(casaId)).data.membros;
      }

      // Household entries: any member reads; only the AUTHOR edits/deletes.
      // Legacy docs without criadoPorUid stay editable by everyone.
      match /transacoes/{transacaoId} {
        allow read: if ehMembro();
        allow create: if ehMembro()
          && (!("criadoPorUid" in request.resource.data)
              || request.resource.data.criadoPorUid == ""
              || request.resource.data.criadoPorUid == request.auth.uid);
        allow update, delete: if ehMembro()
          && (!("criadoPorUid" in resource.data)
              || resource.data.criadoPorUid == ""
              || resource.data.criadoPorUid == request.auth.uid);
      }

      // Categories are collective: any member manages them.
      match /categorias/{categoriaId} {
        allow read, write: if ehMembro();
      }

      // Household cards, goals and bills: collective (any member manages them).
      match /cartoes/{cartaoId} {
        allow read, write: if ehMembro();
      }
      match /metas/{metaId} {
        allow read, write: if ehMembro();
      }
      match /contas/{contaId} {
        allow read, write: if ehMembro();
      }

      // Members-view mirror: each member only writes to their own feed.
      match /membros/{membroUid}/{documento=**} {
        allow read: if ehMembro();
        allow write: if ehMembro() && request.auth.uid == membroUid;
      }
    }

    // Private user data: cross-device sync and cloud backup
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
